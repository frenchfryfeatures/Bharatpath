# =============================================================================
# LOCAL DEVELOPMENT ONLY.  Copy to `.env`.
# =============================================================================
#
# WHY IS EVERYTHING localhost?
#
# Because this file configures the stack in `docker-compose.yml`, which runs
# on your machine: Postgres, Redis, LocalStack (S3/SQS/Secrets Manager) and
# Mailhog. You develop offline, for free, against throwaway data you can drop
# and recreate in seconds.
#
# THIS FILE IS NEVER USED IN A DEPLOYED ENVIRONMENT.
#
# In dev/staging/prod there is no `.env` file at all. The ECS task definition
# injects environment variables whose values come from AWS Secrets Manager,
# and `app/settings.py` reads them once at boot. Same variable names, values
# supplied by infrastructure. That is the whole mechanism.
#
# ARE THESE PASSWORDS "REAL"?
#
# No, and that is the point. `bharatpath_app` / `bharatpath_app` matches
# `scripts/init_db_roles.sql`, which only ever runs against a local container.
# These credentials are safe to commit precisely because they unlock nothing -
# a database that lives on your laptop and holds nothing but test rows.
#
# A real credential must never appear in this file, in `.env`, in a commit, or
# in a chat message. See docs/resources-needed.md section 10.
# =============================================================================

ENVIRONMENT=local
DEBUG=true

# -----------------------------------------------------------------------------
# Database - THREE roles, and the difference between them is load-bearing
# -----------------------------------------------------------------------------
# The application connects as a role that does NOT own the tables and does NOT
# have BYPASSRLS. That is what makes Row-Level Security the real second line of
# tenant isolation rather than decoration.
DATABASE_URL=postgresql+asyncpg://bharatpath_app:bharatpath_app@localhost:5432/bharatpath

# Migrations run as the OWNER role. Never the app role.
#
# RLS does not apply to a table's owner. If Alembic ran as DATABASE_URL, the
# application role would own every table and tenant isolation would silently
# stop applying -- while `\d+` still showed every policy, looking correct.
# `alembic/env.py` refuses to start without this rather than falling back.
DATABASE_URL_MIGRATOR=postgresql+asyncpg://bharatpath_migrator:bharatpath_migrator@localhost:5432/bharatpath

# Admin drill-downs that legitimately cross tenants. A separate engine and a
# separate session factory - deliberately not a boolean on the normal session.
# Every session opened on this role is expected to emit an audit event.
DATABASE_ADMIN_URL=postgresql+asyncpg://bharatpath_admin:bharatpath_admin@localhost:5432/bharatpath

# -----------------------------------------------------------------------------
# Redis - membership cache, OTP throttles, idempotency, locks
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
# ap-south-1 (Mumbai) everywhere, for DPDP data residency. Do not change this
# without the client agreeing in writing.
AWS_REGION=ap-south-1

# LocalStack. Setting an endpoint makes boto3 talk to the container instead of
# real AWS.
#
# IN DEPLOYED ENVIRONMENTS THIS IS UNSET, so boto3 uses real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack accepts any credentials, so these are literally the string "test".
#
# IN DEPLOYED ENVIRONMENTS THESE ARE NOT SET AT ALL. ECS tasks get temporary
# credentials from their IAM task role via the container credentials endpoint,
# automatically. **Long-lived AWS access keys should never exist in a deployed
# environment** - they cannot be rotated without a deploy, they leak through
# logs and backups, and they do not expire. If you ever find yourself pasting
# an AKIA... key into a config, something has gone wrong upstream.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Redis locally, so the worker and beat run with no AWS account at all. The
# deployed host uses Redis too (`redis://redis:6379/1`). `Settings` defaults
# to `sqs://` when this is unset, and that transport does not work yet
# (docs/blockers.md E44) -- always set it.
CELERY_BROKER_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Cognito - cannot be emulated locally
# -----------------------------------------------------------------------------
# LocalStack's free tier does not provide Cognito, so these stay blank on your
# machine and authentication is exercised against a shared dev pool or a fake
# JWT issuer in tests. See the "How do I test X locally?" table in README.md.
#
# Provisioned by whoever owns infrastructure. Pool IDs are not secret; the app
# client secrets are, and those come from Secrets Manager.
COGNITO_CANDIDATE_POOL_ID=
COGNITO_BUSINESS_POOL_ID=
COGNITO_CANDIDATE_CLIENT_ID=
COGNITO_BUSINESS_CLIENT_ID=

# ...which is why this is on. With no pool configured and this unset, `Settings`
# refuses to construct at all -- "No authentication configured" -- and nothing
# boots, Alembic included.
#
# It registers a dev-only provider that mints genuine RS256 tokens signed by a
# key this process generates at boot, plus the one route that hands them out:
# `POST /api/v1/auth/dev/token`. The ordinary verification path runs unchanged,
# so only the issuer is local. `Settings` refuses this flag in staging and
# production, where the route therefore does not exist.
AUTH_ALLOW_LOCAL_TOKENS=true

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------
# The OTP credentials live in the Cognito Lambda triggers, which are outside
# this codebase - only the notification-SMS credentials are read here.
#
# Twilio provides test credentials that exercise the real API without sending
# messages or spending money, so the OTP path is built against the real thing
# rather than a stub. See docs/plan.md section 5.8.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SID=

# -----------------------------------------------------------------------------
# CORS - which browser origins may call this API
# -----------------------------------------------------------------------------
# The web consoles run on different ports locally and different hosts in
# production, so the browser treats every call as cross-origin and blocks it
# unless this allows it. The mobile app is unaffected: CORS is a browser
# mechanism only.
#
# Production would be something like:
#   CORS_ALLOWED_ORIGINS=["https://employer.bharatpath.com","https://college.bharatpath.com"]
#
# Never "*" - with credentials in play browsers refuse it, and it is a real
# security hole besides.
# Single-quoted on purpose: `scripts/dev_api.sh` sources this file with
# `set -a; . ./.env`, and an unquoted value loses its inner double quotes,
# so the API refuses to boot with "error parsing value for field
# cors_allowed_origins". Keep the quotes when you add an origin.
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173"]'

# -- AI providers: OpenAI (CV reading, interview feedback) + Sarvam (speech) --
# Keys go here locally; in a deployed environment they come from Secrets
# Manager and this file is not used. Never commit a real key.
# OpenAI processes in the US: CV text and interview transcripts leave India
# (plan section 13, N2). Sarvam processes in India.
OPENAI_API_KEY=
SARVAM_API_KEY=

# CV reading -> score. Pinned dated snapshot, never the bare alias.
SCORING_EXTRACTION_ENABLED=false
SCORING_EXTRACTION_PROVIDER=openai
SCORING_MODEL_ID=gpt-5.4-mini-2026-03-17

# Mock interview: Sarvam transcribes, OpenAI gives feedback.
INTERVIEW_TRANSCRIPTION_PROVIDER=none
INTERVIEW_EVALUATION_PROVIDER=none
INTERVIEW_EVALUATION_MODEL_ID=gpt-5.4-mini-2026-03-17
SARVAM_STT_MODEL=saaras:v3
# Interview questions are written by OpenAI (the default; needs OPENAI_API_KEY).
# Without a key, set INTERVIEW_QUESTION_PROVIDER=stub for local work only.
INTERVIEW_QUESTION_PROVIDER=openai
INTERVIEW_QUESTION_MODEL_ID=gpt-5.4-mini-2026-03-17
SARVAM_STT_MODE=codemix

# -----------------------------------------------------------------------------
# Payments - the stub IS the bypass
# -----------------------------------------------------------------------------
# No gateway is chosen yet. The stub signs its own callbacks with a real HMAC
# and runs the ordinary verification path, so a checkout completes end to end
# via `POST /billing/dev/payments/{id}/simulate`. `Settings` refuses the stub
# in staging and production, and the default (`none`) answers checkout 503.
PAYMENTS_PROVIDER=stub
