; Module boundary contracts. These are what make later service extraction
; mechanical rather than archaeological, and two of them enforce product
; invariants directly. See docs/plan.md section 2 and section 4.
;
; Run with:  lint-imports

[importlinter]
root_package = app
include_external_packages = True

; ---------------------------------------------------------------------------
; INVARIANT 4' — add-on modules can never write a score.
;
; The original rule was "questionnaire and interview must not import scoring",
; which enforced the now-rescinded rule that add-ons never move the score.
; The client reversed that on 2026-08-24 ("It will change it"), so the
; dependency was INVERTED, not deleted: `scoring` reads add-on completion
; events; the add-on modules still import nothing from `scoring`.
;
; Keeping this contract is what stops an add-on module reaching in and
; awarding itself points.
; ---------------------------------------------------------------------------
[importlinter:contract:addons-never-import-scoring]
name = Add-on modules must not import scoring (invariant 4-prime)
type = forbidden
source_modules =
    app.modules.questionnaire
    app.modules.interview
    app.modules.courses
forbidden_modules =
    app.modules.scoring

; ---------------------------------------------------------------------------
; SRS 1.4.5 — integrity detection never directly modifies the score.
;
; A dishonest CV is handled by a human looking at it. The alternative — a
; quiet deduction the candidate can neither see nor appeal — is the thing this
; contract exists to make impossible to add by accident. `integrity` raises
; signals; `discovery` suppresses on them; neither path runs through `scoring`.
; ---------------------------------------------------------------------------
[importlinter:contract:integrity-never-imports-scoring]
name = Integrity detection must not import scoring (SRS 1.4.5)
type = forbidden
source_modules =
    app.modules.integrity
forbidden_modules =
    app.modules.scoring

; ---------------------------------------------------------------------------
; A message never carries the score.
;
; An SMS is readable by anyone holding the phone, and the score sits behind a
; subscription (R5/R13): "your score is 842" on a lock screen defeats both the
; paywall and the privacy. `notifications/templates.py` has no variable for
; it; this stops the module reaching for one. Direct imports only -- the
; module reads colleges and identities through their services, and those are
; not how a number gets into a message body.
; ---------------------------------------------------------------------------
[importlinter:contract:notifications-never-import-scoring]
name = Notifications never import scoring (a message never carries the score)
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.notifications
forbidden_modules =
    app.modules.scoring

; ---------------------------------------------------------------------------
; Streak points never move the score, and the score never reads streaks.
;
; The client asked for streak points (2026-09-13): -10 for a missed day, +10 /
; +15 / +20 at 30 / 90 / 365 days. Applied to the score, that breaks
; invariants 1, 2, 3 and 4-prime at once -- a -10 takes a score below its 700
; base, milestones take it past 990, and "opened the app" is not an input any
; replay can reproduce. So they are a separate balance, and this contract is
; what keeps them separate: independence, so neither module can reach the
; other directly or through a third. See docs/streaks.md section 2.
; ---------------------------------------------------------------------------
[importlinter:contract:engagement-and-scoring-are-independent]
name = Streak points never move the score (docs/streaks.md)
type = independence
modules =
    app.modules.engagement
    app.modules.scoring

; ---------------------------------------------------------------------------
; Engagement points are not an employer signal.
;
; A streak measures how often someone opens an app, not whether they can do a
; job. Shown to an employer it becomes a second, unexplained ranking -- and
; one that penalises a candidate for being busy, ill, or offline. Changing
; that is a client decision, not an import.
; ---------------------------------------------------------------------------
[importlinter:contract:engagement-is-not-an-employer-signal]
name = Employer and college surfaces never read engagement points
type = forbidden
source_modules =
    app.modules.employer
    app.modules.jobs
    app.modules.applications
    app.modules.discovery
    app.modules.college
    app.modules.analytics
forbidden_modules =
    app.modules.engagement

; ---------------------------------------------------------------------------
; Layering inside every module: routers -> services -> repositories.
; A router that touches a repository has skipped the transaction boundary
; and the business rules with it.
;
; `allow_indirect_imports` is what makes this contract mean what its name
; says. Without it the contract also forbids router -> service ->
; repository, which is the exact layering it exists to enforce -- so it
; would fail on every correctly built module and pass only on one whose
; service does no persistence. The rule is about the DIRECT import.
; ---------------------------------------------------------------------------
[importlinter:contract:layers]
name = Routers never touch repositories
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.*.router
forbidden_modules =
    app.modules.*.repository

; ---------------------------------------------------------------------------
; Cross-module access goes through the public service, never through another
; module's repository or ORM models. This is the single rule that makes a
; module extractable into its own service later.
; ---------------------------------------------------------------------------
[importlinter:contract:module-privacy]
name = A module's repository and models are private to it
type = forbidden
; `allow_indirect_imports`, for the third time in this file and for the same
; reason as `layers` and `resume-internals-are-private`. Without it this also
; forbids employer.service -> identity.service -> identity.repository: the
; path this contract exists to push cross-module traffic INTO. The rule is
; about the DIRECT import.
allow_indirect_imports = True
source_modules =
    app.modules.candidate
    app.modules.resume
    app.modules.scoring
    app.modules.integrity
    app.modules.questionnaire
    app.modules.interview
    app.modules.courses
    app.modules.employer
    app.modules.kyb
    app.modules.jobs
    app.modules.applications
    app.modules.discovery
    app.modules.billing
    app.modules.subscriptions
    app.modules.college
    app.modules.analytics
    app.modules.admin
    app.modules.notifications
    app.modules.privacy
    app.modules.engagement
forbidden_modules =
    app.modules.identity.repository
    app.modules.identity.models

; ---------------------------------------------------------------------------
; SRS 1.4.4 — the confirm gate has exactly one door.
;
; An unconfirmed resume version must never reach scoring. That rule lives in
; `resume.service.get_scorable_version`, which is the only function that
; filters on `confirmed_at IS NOT NULL`.
;
; A rule in a service is only a rule while the service is the only way in.
; `resume.repository` has `list_versions` and `get_version`, both of which
; return unconfirmed rows quite correctly — they serve the review screen. A
; scoring module that imported the repository directly would reach those, and
; the gate would be bypassed by a caller who never knew it was there.
;
; So resume's internals are private to resume, exactly as identity's are, and
; every other module goes through the service. `resume` itself is absent from
; the source list because a module importing its own repository is the design.
; ---------------------------------------------------------------------------
[importlinter:contract:resume-internals-are-private]
name = The confirm gate is the only route to a resume version (SRS 1.4.4)
type = forbidden
; `allow_indirect_imports` for the same reason the `layers` contract above
; needs it, and it bit here exactly as it bit there. Without it this also
; forbids scoring.service -> resume.service -> resume.repository, which is the
; intended path and the one this contract exists to funnel traffic INTO. The
; rule is about the DIRECT import: reaching past the service, not reaching
; through it.
allow_indirect_imports = True
source_modules =
    app.modules.candidate
    app.modules.scoring
    app.modules.integrity
    app.modules.questionnaire
    app.modules.interview
    app.modules.courses
    app.modules.employer
    app.modules.kyb
    app.modules.jobs
    app.modules.applications
    app.modules.discovery
    app.modules.billing
    app.modules.subscriptions
    app.modules.college
    app.modules.analytics
    app.modules.admin
    app.modules.notifications
    app.modules.privacy
    app.modules.engagement
forbidden_modules =
    app.modules.resume.repository
    app.modules.resume.models

; ---------------------------------------------------------------------------
; domain.py is pure. No I/O, no DB, no HTTP, no clock, no randomness that
; isn't passed in. This is what makes the invariant property tests possible.
; ---------------------------------------------------------------------------
[importlinter:contract:domain-is-pure]
name = domain.py imports no I/O
type = forbidden
source_modules =
    app.modules.*.domain
forbidden_modules =
    sqlalchemy
    redis
    boto3
    httpx
    fastapi
    app.core.db

; ---------------------------------------------------------------------------
; Core is the foundation, so it must not depend on anything built on top of
; it. This is what keeps `identity` extractable later: authentication reads
; `users` and `memberships` with explicit SQL in app/core/auth rather than
; importing the module that owns them, and this contract is what stops that
; shortcut being taken back.
; ---------------------------------------------------------------------------
[importlinter:contract:core-depends-on-nothing]
name = app.core never imports app.modules
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
; The one deliberate exception, and the reason it is safe: this module exists
; ONLY to populate `Base.metadata` for Alembic and the schema guards. It
; imports each module's `models.py` for its registration side effect and calls
; nothing. Alembic cannot generate a migration without it, and every other
; route to the same result -- an import loop written out three times, a
; hardcoded table list -- drifts. See app/core/metadata.py.
ignore_imports =
    app.core.metadata -> app.modules
