NEXT_PUBLIC_API_URL=http://localhost:8099/api/v1/

# Server-only: backend base URL used by the email-only sign-in routes
# (app/api/auth/*). Never NEXT_PUBLIC_*. Defaults to nothing; required for sign-in.
BACKEND_API_URL=http://localhost:8099/api/v1

# Server-only: path to the seeded account directory used by the email-only
# sign-in. Defaults to the bundled lib/auth/accounts.json, which
# backend/scripts/seed_demo.py rewrites on every seed.
# DEV_ACCOUNTS_FILE=

# Local-dev only: bearer token for auth-gated routes (e.g. employer jobs).
# Mint one via the dev token provider when AUTH_ALLOW_LOCAL_TOKENS=true on the backend.
# Never set this in a real deployment - it is exposed to the browser.
