# The backend's base URL. Read directly in the browser (lib/auth/backend-auth.ts,
# store/api/base-api.ts) - every request, auth included, goes straight to the
# backend; there is no Next.js API route standing in between.
NEXT_PUBLIC_API_URL=https://bharatpath-api.duckdns.org/api/v1

# AWS Cognito - Candidate Pool (Students / Job Seekers)
# terraform output cognito_candidate_pool_id
NEXT_PUBLIC_COGNITO_CANDIDATE_USER_POOL_ID=
# terraform output cognito_candidate_client_id
NEXT_PUBLIC_COGNITO_CANDIDATE_CLIENT_ID=

# AWS Cognito - Business Pool (Employers, Colleges, Admins)
# terraform output cognito_business_pool_id
NEXT_PUBLIC_COGNITO_BUSINESS_USER_POOL_ID=
# terraform output cognito_business_client_id
NEXT_PUBLIC_COGNITO_BUSINESS_CLIENT_ID=
 
NEXT_PUBLIC_COGNITO_REGION=

# Portal origins: role selects the domain; paths remain /dashboard, /jobs, etc.
NEXT_PUBLIC_BASE_DOMAIN=http://localhost:3000
NEXT_PUBLIC_ADMIN_DOMAIN=http://admin.localhost:3000
NEXT_PUBLIC_EMPLOYER_DOMAIN=http://employer.localhost:3000
NEXT_PUBLIC_COLLEGE_DOMAIN=http://college.localhost:3000
