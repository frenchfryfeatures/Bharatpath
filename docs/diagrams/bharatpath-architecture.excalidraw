   "isDeleted": false,
   "boundElements": [],
   "updated": 1759017600000,
   "link": null,
   "locked": false,
   "text": "Nothing is granted, re-scored or sent until the relay runs. Delivery is at-least-once, so every consumer is idempotent by what it acts on.",
   "originalText": "Nothing is granted, re-scored or sent until the relay runs. Delivery is at-least-once, so every consumer is idempotent by what it acts on.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 14
  },
