  },
  {
   "id": "12zntml1y21q0yd8",
   "type": "text",
   "x": 40,
   "y": 1603.0,
   "width": 1758.5,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
