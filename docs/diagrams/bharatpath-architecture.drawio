 height="22" as="geometry"/></mxCell><mxCell id="cplatfo80" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="cplatfo71"><mxGeometry x="20" y="130" width="1" height="1" as="geometry"/></mxCell><mxCell id="cplatfo81" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="cplatfo71"><mxGeometry x="110" y="130" width="1" height="1" as="geometry"/></mxCell><mxCell id="cplatfo82" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#333333;strokeColor=#EF6C00;dashed=1;" edge="1" parent="1" source="cplatfo80" target="cplatfo81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cplatfo83" value="Asynchronous task or schedule" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="cplatfo71"><mxGeometry x="125" y="120" width="280" height="22" as="geometry"/></mxCell><mxCell id="cplatfo84" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="cplatfo71"><mxGeometry x="20" y="170" width="1" height="1" as="geometry"/></mxCell><mxCell id="cplatfo85" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="cplatfo71"><mxGeometry x="110" y="170" width="1" height="1" as="geometry"/></mxCell><mxCell id="cplatfo86" value="" style="fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#333333;strokeColor=#2E7D32;" edge="1" parent="1" source="cplatfo84" target="cplatfo85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cplatfo87" value="Outbound call to a third party" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="cplatfo71"><mxGeometry x="125" y="160" width="280" height="22" as="geometry"/></mxCell><mxCell id="cplatfo88" value="Box borders: blue = edge · indigo = application · orange = background work · purple = data" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#616161;" vertex="1" parent="cplatfo71"><mxGeometry x="20" y="202" width="400" height="16" as="geometry"/></mxCell><mxCell id="cplatfo89" value="PLATFORM GUARANTEES — enforced by code, automated tests and database constraints" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F5F7FA;strokeColor=#1F2A44;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="480" y="1260" width="1660" height="220" as="geometry"/></mxCell><mxCell id="cplatfo90" value="&lt;b&gt;Tenant isolation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Each employer and college sees only its own rows: PostgreSQL row-level security, not just application checks&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="20" y="45" width="258" height="160" as="geometry"/></mxCell><mxCell id="cplatfo91" value="&lt;b&gt;Explainable, replayable score&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;AI reads the CV; versioned rule code computes the 700–990 score. Stored once, reproducible years later&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="292" y="45" width="258" height="160" as="geometry"/></mxCell><mxCell id="cplatfo92" value="&lt;b&gt;Candidate confirms first&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;No CV is scored until the candidate has reviewed and confirmed what was read from it&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="564" y="45" width="258" height="160" as="geometry"/></mxCell><mxCell id="cplatfo93" value="&lt;b&gt;Fair by construction&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;No age or gender field anywhere; screening questions on age or gender are refused. Checked on every build&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="836" y="45" width="258" height="160" as="geometry"/></mxCell><mxCell id="cplatfo94" value="&lt;b&gt;Privacy &amp;amp; consent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Employers see bands on masked cards; every profile open is audited. Colleges see students only with consent&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="1108" y="45" width="258" height="160" as="geometry"/></mxCell><mxCell id="cplatfo95" value="&lt;b&gt;Data residency&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Database, files, OCR and identity all run in Mumbai (ap-south-1)&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1F2A44;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo89"><mxGeometry x="1380" y="45" width="258" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>