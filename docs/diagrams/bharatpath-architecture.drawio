<mxfile host="app.diagrams.net" agent="BharatPath" version="24.7.17"><diagram id="platform-architecture" name="Platform architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2180" pageHeight="1520" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cplatfo1" value="" style="rounded=0;fillColor=#1F2A44;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2180" height="96" as="geometry"/></mxCell><mxCell id="cplatfo2" value="&lt;b&gt;BharatPath — Platform Architecture&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1500" height="40" as="geometry"/></mxCell><mxCell id="cplatfo3" value="Three-sided hiring marketplace for candidates, employers and colleges · production deployment on AWS Asia Pacific (Mumbai) · October 2026" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#C9D3E6;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="30" as="geometry"/></mxCell><mxCell id="cplatfo4" value="v1.0 · 17 Oct 2026" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;fontColor=#C9D3E6;" vertex="1" parent="1"><mxGeometry x="1700" y="30" width="450" height="40" as="geometry"/></mxCell><mxCell id="cplatfo5" value="CLIENT CHANNELS" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F3F8FE;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="1050" as="geometry"/></mxCell><mxCell id="cplatfo6" value="&lt;b&gt;Who uses it&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;• &lt;b&gt;Candidates&lt;/b&gt; — job seekers and students&lt;br&gt;• &lt;b&gt;Employers&lt;/b&gt; — owners, recruiters, viewers&lt;br&gt;• &lt;b&gt;Colleges&lt;/b&gt; — placement cells&lt;br&gt;• &lt;b&gt;BharatPath staff&lt;/b&gt; — verification, review, support&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#B0B7C3;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo5"><mxGeometry x="16" y="45" width="268" height="170" as="geometry"/></mxCell><mxCell id="cplatfo7" value="&lt;b&gt;Candidate mobile app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;React Native 0.81 · Expo SDK 54&lt;br&gt;Android &amp;amp; iOS&lt;br&gt;Sign-in via AWS Amplify → Cognito&lt;br&gt;Phone notifications via Expo push&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1565C0;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo5"><mxGeometry x="16" y="245" width="268" height="150" as="geometry"/></mxCell><mxCell id="cplatfo8" value="&lt;b&gt;Web portals&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Next.js 16 · React 19 · Tailwind&lt;br&gt;Hosted on Vercel&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#1565C0;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo5"><mxGeometry x="16" y="425" width="268" height="330" as="geometry"/></mxCell><mxCell id="cplatfo9" value="&lt;b&gt;Student portal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;CV, score, jobs, applications&lt;/span&gt;" style="rounded=1;arcSize=30;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#90CAF9;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cplatfo5"><mxGeometry x="32" y="500" width="236" height="48" as="geometry"/></mxCell><mxCell id="cplatfo10" value="&lt;b&gt;Employer portal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;KYB, jobs, search, hiring pipeline&lt;/span&gt;" style="rounded=1;arcSize=30;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#90CAF9;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cplatfo5"><mxGeometry x="32" y="560" width="236" height="48" as="geometry"/></mxCell><mxCell id="cplatfo11" value="&lt;b&gt;College portal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;seats, roster, analytics&lt;/span&gt;" style="rounded=1;arcSize=30;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#90CAF9;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cplatfo5"><mxGeometry x="32" y="620" width="236" height="48" as="geometry"/></mxCell><mxCell id="cplatfo12" value="&lt;b&gt;Admin console&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;staff: review, disputes, settings&lt;/span&gt;" style="rounded=1;arcSize=30;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#90CAF9;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cplatfo5"><mxGeometry x="32" y="680" width="236" height="48" as="geometry"/></mxCell><mxCell id="cplatfo13" value="&lt;b&gt;Nine languages&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Full: English, Hindi, Bengali, Kannada, Marathi, Punjabi&lt;br&gt;Core screens: Gujarati, Tamil, Telugu&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#B0B7C3;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo5"><mxGeometry x="16" y="785" width="268" height="115" as="geometry"/></mxCell><mxCell id="cplatfo14" value="&lt;b&gt;One API contract&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Versioned REST &lt;b&gt;/api/v1&lt;/b&gt;, OpenAPI documented, machine-readable error codes (RFC 9457)&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#B0B7C3;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo5"><mxGeometry x="16" y="920" width="268" height="115" as="geometry"/></mxCell><mxCell id="cplatfo15" value="AWS Cloud · account on Free plan (upgrade before 2027-04-01)" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="1380" height="1050" as="geometry"/></mxCell><mxCell id="cplatfo16" value="Region ap-south-1 · Asia Pacific (Mumbai) — all personal data stays in India" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="cplatfo15"><mxGeometry x="20" y="60" width="1340" height="970" as="geometry"/></mxCell><mxCell id="cplatfo17" value="VPC" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="cplatfo16"><mxGeometry x="20" y="50" width="900" height="900" as="geometry"/></mxCell><mxCell id="cplatfo18" value="Public subnet · security group: HTTPS 443 / 80 open, SSH 22 restricted to admin IPs" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#7AA116;fillColor=#F7FAF0;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="cplatfo17"><mxGeometry x="20" y="40" width="860" height="600" as="geometry"/></mxCell><mxCell id="cplatfo19" value="EC2 t3.small · Elastic IP · Docker Compose — every service from one container image" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" vertex="1" parent="cplatfo18"><mxGeometry x="20" y="40" width="820" height="540" as="geometry"/></mxCell><mxCell id="cplatfo20" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Reverse proxy&lt;br&gt;Automatic TLS&lt;br&gt;(Let's Encrypt)&lt;/span&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="cplatfo19"><mxGeometry x="20" y="60" width="150" height="110" as="geometry"/></mxCell><mxCell id="cplatfo21" value="&lt;b&gt;Migrate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Alembic, runs once&lt;br&gt;per deploy&lt;/span&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#F5F5F5;strokeColor=#9E9E9E;dashed=1;" vertex="1" parent="cplatfo19"><mxGeometry x="20" y="205" width="150" height="95" as="geometry"/></mxCell><mxCell id="cplatfo22" value="&lt;b&gt;BharatPath API&lt;/b&gt; — FastAPI · Python 3.12 · Uvicorn · modular monolith" style="rounded=1;arcSize=3;fontFamily=Helvetica;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#EEF2FF;strokeColor=#3949AB;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontColor=#1A237E;" vertex="1" parent="cplatfo19"><mxGeometry x="190" y="40" width="610" height="360" as="geometry"/></mxCell><mxCell id="cplatfo23" value="&lt;b&gt;Identity &amp;amp; platform&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;identity · admin · privacy · notifications&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Accounts, roles, staff console, data rights, email / in-app / push&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="15" y="35" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo24" value="&lt;b&gt;Candidate profile&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;candidate · resume · resume_builder · profile_images · engagement&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;CV upload &amp;amp; parsing, CV builder, photos, streaks&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="215" y="35" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo25" value="&lt;b&gt;Scoring &amp;amp; trust&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;scoring · integrity&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;700–990 score, bands, replay; integrity signals for human review&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="415" y="35" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo26" value="&lt;b&gt;Marketplace&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;jobs · applications · discovery · assistant&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Job board, hiring pipeline, masked search, AI job assistant&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="15" y="168" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo27" value="&lt;b&gt;Organisations&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;employer · kyb · college · analytics&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Employer verification, seats &amp;amp; rosters, consented analytics&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="215" y="168" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo28" value="&lt;b&gt;Commerce &amp;amp; add-ons&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#3949AB'&gt;billing · subscriptions · courses · interview · questionnaire&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Payments, discount codes, courses, AI voice mock interview&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7986CB;fontSize=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="cplatfo22"><mxGeometry x="415" y="168" width="185" height="123" as="geometry"/></mxCell><mxCell id="cplatfo29" value="&lt;b&gt;Core:&lt;/b&gt; Cognito token verification · role from memberships (60 s cache) · tenant binding for row-level security · rate limits · audit log · transactional outbox · i18n · versioned configuration" style="rounded=1;arcSize=10;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cplatfo22"><mxGeometry x="15" y="303" width="585" height="48" as="geometry"/></mxCell><mxCell id="cplatfo30" value="&lt;b&gt;Celery worker — same image as the API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;CV parsing · scoring · integrity checks · payment settlement · interview transcription &amp;amp; feedback · notifications · erasure&lt;/span&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="cplatfo19"><mxGeometry x="20" y="420" width="380" height="105" as="geometry"/></mxCell><mxCell id="cplatfo31" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Task broker · membership cache · rate-limit counters&lt;/span&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="cplatfo19"><mxGeometry x="420" y="420" width="180" height="105" as="geometry"/></mxCell><mxCell id="cplatfo32" value="&lt;b&gt;Celery Beat (exactly one)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#4D4D4D'&gt;Outbox relay every 30 s · expiry &amp;amp; renewals hourly · daily housekeeping&lt;/span&gt;" style="rounded=1;arcSize=8;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="cplatfo19"><mxGeometry x="620" y="420" width="180" height="105" as="geometry"/></mxCell><mxCell id="cplatfo33" value="Private subnet · no public IP · port 5432 open to the EC2 host only" style="points=[];outlineConnect=0;gradientColor=none;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#EFF9FA;verticalAlign=top;align=right;spacingRight=12;fontColor=#147EBA;dashed=0;" vertex="1" parent="cplatfo17"><mxGeometry x="20" y="660" width="860" height="220" as="geometry"/></mxCell><mxCell id="cplatfo34" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;" vertex="1" parent="cplatfo33"><mxGeometry x="30" y="55" width="64" height="64" as="geometry"/></mxCell><mxCell id="cplatfo35" value="&lt;b&gt;Amazon RDS&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="cplatfo33"><mxGeometry x="10" y="125" width="104" height="40" as="geometry"/></mxCell><mxCell id="cplatfo36" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;db.t4g.micro · 20 GB gp3, grows to 50 GB&lt;br&gt;TLS enforced and verified&lt;br&gt;Daily snapshot + point-in-time restore&lt;br&gt;Three roles: app · migrator · read-only admin&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#C925D1;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo33"><mxGeometry x="120" y="35" width="330" height="170" as="geometry"/></mxCell><mxCell id="cplatfo37" value="&lt;b&gt;Protection inside the database&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;• Row-level security per employer, college and candidate&lt;br&gt;• Scores, audit trail and events are insert-only&lt;br&gt;• Triggers guard every state machine (applications, payments, seats)&lt;br&gt;• Account erasure in one transaction (DPDP)&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#C925D1;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo33"><mxGeometry x="465" y="35" width="380" height="170" as="geometry"/></mxCell><mxCell id="cplatfo38" value="AWS MANAGED SERVICES" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;strokeColor=#232F3E;verticalAlign=top;align=center;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="cplatfo16"><mxGeometry x="940" y="50" width="380" height="900" as="geometry"/></mxCell><mxCell id="cplatfo39" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#DD344C;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="51" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo40" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Two user pools: candidates, and business (employers, colleges, staff). Email + password; optional authenticator MFA&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="45" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo41" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;fillColor=#DD344C;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="169" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo42" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Transactional email: verification, hiring updates, payment notices&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="163" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo43" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.textract;fillColor=#01A88D;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="287" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo44" value="&lt;b&gt;Amazon Textract&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;OCR fallback for scanned CVs only — normal CVs are read locally at no cost&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="281" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo45" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="405" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo46" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Database master credentials&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="399" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo47" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#C925D1;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="523" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo48" value="&lt;b&gt;Terraform state (S3 + DynamoDB)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;All infrastructure is code; state locked against concurrent changes&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="517" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo49" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;fillColor=#7AA116;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="641" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo50" value="&lt;b&gt;AWS Budgets &amp;amp; alerts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Email alerts on monthly spend thresholds and forecast&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="635" width="285" height="100" as="geometry"/></mxCell><mxCell id="cplatfo51" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="cplatfo38"><mxGeometry x="20" y="765" width="52" height="52" as="geometry"/></mxCell><mxCell id="cplatfo52" value="&lt;b&gt;Amazon S3 — 7 private buckets&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#4D4D4D'&gt;Encrypted, versioned, never public: CVs, KYB documents, interview audio, exports, audit archive, course media, profile images. Clients use short-lived presigned links&lt;/span&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1A1A1A;" vertex="1" parent="cplatfo38"><mxGeometry x="85" y="755" width="285" height="135" as="geometry"/></mxCell><mxCell id="cplatfo53" value="THIRD-PARTY SERVICES" style="rounded=1;arcSize=2;fontFamily=Helvetica;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F4FAF4;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="1800" y="150" width="340" height="1050" as="geometry"/></mxCell><mxCell id="cplatfo54" value="&lt;b&gt;OpenAI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Reads each CV into facts (Layer 1, cached per CV) · writes interview questions and feedback · powers the job-search assistant. Never sees score weights&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="50" width="300" height="145" as="geometry"/></mxCell><mxCell id="cplatfo55" value="&lt;b&gt;Sarvam AI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Speech-to-text for interview answers (Saaras) · reads questions aloud in the candidate's language (Bulbul)&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="212" width="300" height="145" as="geometry"/></mxCell><mxCell id="cplatfo56" value="&lt;b&gt;Expo Push → FCM / APNs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Phone notifications on Android and iOS, generic lock-screen text&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="374" width="300" height="145" as="geometry"/></mxCell><mxCell id="cplatfo57" value="&lt;b&gt;Payment gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;To be selected by the client. Today: a signed stub adapter — one class to swap, no API change. Callbacks verified by HMAC&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="536" width="300" height="145" as="geometry"/></mxCell><mxCell id="cplatfo58" value="&lt;b&gt;YouTube&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;Unlisted course lesson videos&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="698" width="300" height="145" as="geometry"/></mxCell><mxCell id="cplatfo59" value="&lt;b&gt;DuckDNS + Let's Encrypt&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#4D4D4D'&gt;API domain and TLS certificates — to move to the client's own domain&lt;/span&gt;" style="rounded=1;arcSize=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#66BB6A;align=left;verticalAlign=top;spacing=8;spacingTop=4;fontSize=13;" vertex="1" parent="cplatfo53"><mxGeometry x="20" y="860" width="30