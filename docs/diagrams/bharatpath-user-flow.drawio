<mxfile host="app.diagrams.net" agent="BharatPath" version="24.7.17"><diagram id="1-·-onboarding-&-scoring" name="1 · Onboarding &amp; scoring"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2860" pageHeight="1480" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1onboa1" value="" style="rounded=0;fillColor=#1F2A44;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2860" height="90" as="geometry"/></mxCell><mxCell id="c1onboa2" value="&lt;b&gt;BharatPath — User Flow 1 of 2: Onboarding, Verification &amp;amp; Scoring&lt;/b&gt;" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c1onboa3" value="How each side joins the platform, how employers are verified, and how a CV becomes a 700–990 score" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#C9D3E6;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="2000" height="30" as="geometry"/></mxCell><mxCell id="c1onboa4" value="BharatPath · v1.0 · 17 Oct 2026" style="text;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=12;fontColor=#C9D3E6;" vertex="1" parent="1"><mxGeometry x="2400" y="30" width="420" height="30" as="geometry"/></mxCell><mxCell id="c1onboa5" value="Candidate" style="swimlane;horizontal=0;startSize=48;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=#1565C0;fontColor=#FFFFFF;swimlaneFillColor=#F3F8FE;fontSize=14;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="2820" height="300" as="geometry"/></mxCell><mxCell id="c1onboa6" value="BharatPath platform&lt;br&gt;(automated)" style="swimlane;horizontal=0;startSize=48;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#5E35B1;strokeColor=#5E35B1;fontColor=#FFFFFF;swimlaneFillColor=#F7F4FC;fontSize=14;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="2820" height="300" as="geometry"/></mxCell><mxCell id="c1onboa7" value="BharatPath staff&lt;br&gt;(admin console)" style="swimlane;horizontal=0;startSize=48;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EF6C00;strokeColor=#EF6C00;fontColor=#FFFFFF;swimlaneFillColor=#FFF8F0;fontSize=14;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="2820" height="200" as="geometry"/></mxCell><mxCell id="c1onboa8" value="Employer" style="swimlane;horizontal=0;startSize=48;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;swimlaneFillColor=#F3FAF3;fontSize=14;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="2820" height="200" as="geometry"/></mxCell><mxCell id="c1onboa9" value="College" style="swimlane;horizontal=0;startSize=48;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#AD1457;strokeColor=#AD1457;fontColor=#FFFFFF;swimlaneFillColor=#FDF3F7;fontSize=14;fontStyle=1;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="20" y="1110" width="2820" height="200" as="geometry"/></mxCell><mxCell id="c1onboa10" value="&lt;b&gt;Candidate opens the app or student portal&lt;/b&gt;" style="rounded=1;arcSize=50;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#1565C0;" vertex="1" parent="c1onboa5"><mxGeometry x="88" y="118.0" width="164" height="64" as="geometry"/></mxCell><mxCell id="c1onboa11" value="&lt;b&gt;Sign up&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Email + password (Amazon Cognito)&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="284" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa12" value="&lt;b&gt;Onboarding&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Name, city, career goals, preferences&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="480" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa13" value="&lt;b&gt;Has a CV?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c1onboa5"><mxGeometry x="688.0" y="102.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c1onboa14" value="&lt;b&gt;Upload CV&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;PDF or Word&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="872" y="22.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa15" value="&lt;b&gt;Build a CV&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Resume Builder · 4 templates, pre-filled from answers&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="872" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa16" value="&lt;b&gt;Review what was read&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Correct any section before it counts&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="1460" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa17" value="&lt;b&gt;Pay for access&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Subscription (UPI / card, discount codes) — or a college seat&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="1656" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa18" value="&lt;b&gt;Confirm CV version&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Only a confirmed CV is ever scored&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#C62828;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="1852" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa19" value="&lt;b&gt;Score shown&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;700–990 and band · never the breakdown&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="2244" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa20" value="&lt;b&gt;Optional add-ons&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;AI voice mock interview · courses · questionnaire&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa5"><mxGeometry x="2440" y="22.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa21" value="&lt;b&gt;Store &amp;amp; read the CV&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Private S3 · text read locally (PDF / Word)&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="1068" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa22" value="&lt;b&gt;Over 10 pages or 30,000 characters&lt;/b&gt; is refused, never truncated — a CV, not a book." style="shape=note;size=14;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontColor=#5D4037;align=left;spacing=6;" vertex="1" parent="c1onboa6"><mxGeometry x="1068" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa23" value="&lt;b&gt;Enough text?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5E35B1;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c1onboa6"><mxGeometry x="1276.0" y="102.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c1onboa24" value="&lt;b&gt;OCR fallback&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Amazon Textract, only for scanned CVs&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="1264" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa25" value="&lt;b&gt;Integrity scan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Hidden text, injected instructions, anomalies&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="1460" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa26" value="&lt;b&gt;AI reads the facts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Layer 1 · cached per CV · never sees weights or totals&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="1852" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa27" value="&lt;b&gt;Rules compute the score&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Layers 2–3 · stored insert-only, replayable&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#C62828;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="2048" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa28" value="&lt;b&gt;Serious integrity signal?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5E35B1;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c1onboa6"><mxGeometry x="2256.0" y="102.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c1onboa29" value="&lt;b&gt;Searchable profile&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Masked card for employers: name, band, skills, city&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="2440" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa30" value="&lt;b&gt;Re-score with add-ons&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;+20 per interview, capped at +60&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa6"><mxGeometry x="2636" y="22.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa31" value="&lt;b&gt;Ready for hiring → Flow 2&lt;/b&gt;" style="rounded=1;arcSize=50;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#5E35B1;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="c1onboa6"><mxGeometry x="2636" y="214.0" width="164" height="64" as="geometry"/></mxCell><mxCell id="c1onboa32" value="&lt;b&gt;Review KYB&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Approve · send back with flags · reject&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa7"><mxGeometry x="872" y="60.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa33" value="&lt;b&gt;Allocate seats&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Up to the plan's seat allowance&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa7"><mxGeometry x="1264" y="60.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa34" value="&lt;b&gt;Human review&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Clear (profile returns) or confirm (stays hidden)&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa7"><mxGeometry x="2244" y="60.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa35" value="&lt;b&gt;Employer signs up (business account)&lt;/b&gt;" style="rounded=1;arcSize=50;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="c1onboa8"><mxGeometry x="88" y="68.0" width="164" height="64" as="geometry"/></mxCell><mxCell id="c1onboa36" value="&lt;b&gt;Create organisation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Public profile, logo, team members&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa8"><mxGeometry x="284" y="60.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa37" value="&lt;b&gt;Submit KYB&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;PAN, GSTIN, CIN, address, signatory, documents&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c1onboa8"><mxGeometry x="480" y="60.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c1onboa38" value="&lt;b&gt;Manual approval switched on?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c1onboa8"><mxGeometry x="688.0" y="52.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c1onboa39" value="&lt;b&gt;Pay for access&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Subscription opens the access window&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#C62828;str