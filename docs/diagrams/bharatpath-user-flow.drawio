y=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin5"><mxGeometry x="872" y="90.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin15" value="&lt;b&gt;Review applicants&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Opened application shows contact &amp;amp; CV&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin5"><mxGeometry x="1460" y="90.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin16" value="&lt;b&gt;Advance stages&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Viewed → Shortlisted → Interview → Decision · message the candidate&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin5"><mxGeometry x="1656" y="90.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin17" value="&lt;b&gt;Outcome?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c2hirin5"><mxGeometry x="1864.0" y="82.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c2hirin18" value="&lt;b&gt;Propose hire&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Employer cannot mark hired alone&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin5"><mxGeometry x="2048" y="90.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin19" value="&lt;b&gt;Publish to job board&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Checks verification &amp;amp; subscription&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#C62828;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="284" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin20" value="&lt;b&gt;Masked results&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Name, band, skills, city — no contact, no score&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="480" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin21" value="&lt;b&gt;Profile-open checks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Hourly / daily caps · every open audited&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#C62828;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="676" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin22" value="Unusual viewing raises an alert to staff. Candidates can see which employers viewed them." style="shape=note;size=14;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontColor=#5D4037;align=left;spacing=6;" vertex="1" parent="c2hirin6"><mxGeometry x="676" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin23" value="&lt;b&gt;Application created&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Stage rules enforced in the database · full audit trail&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#C62828;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="1264" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin24" value="&lt;b&gt;Notify&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Email · in-app inbox · phone push&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="1460" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin25" value="&lt;b&gt;Expiry sweep (hourly)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Applications the employer left idle expire&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="1656" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin26" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Candidate informed; may apply elsewhere&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="1852" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin27" value="&lt;b&gt;Hire recorded&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Both sides confirmed&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin6"><mxGeometry x="2244" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin28" value="&lt;b&gt;Placement complete&lt;/b&gt;" style="rounded=1;arcSize=50;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#5E35B1;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;" vertex="1" parent="c2hirin6"><mxGeometry x="2440" y="118.0" width="164" height="64" as="geometry"/></mxCell><mxCell id="c2hirin29" value="&lt;b&gt;Candidate with a confirmed score&lt;/b&gt;" style="rounded=1;arcSize=50;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#1565C0;" vertex="1" parent="c2hirin7"><mxGeometry x="88" y="118.0" width="164" height="64" as="geometry"/></mxCell><mxCell id="c2hirin30" value="&lt;b&gt;Find jobs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Job board · recommended jobs · AI job assistant&lt;/span&gt;" style="rounded=1;arcSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.3;fontSize=12;fontColor=#1A1A1A;spacing=5;" vertex="1" parent="c2hirin7"><mxGeometry x="480" y="110.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin31" value="&lt;b&gt;Eligible for this job?&lt;/b&gt;" style="rhombus;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=1.8;fontSize=11;fontColor=#1A1A1A;spacing=12;" vertex="1" parent="c2hirin7"><mxGeometry x="688.0" y="102.0" width="140" height="96" as="geometry"/></mxCell><mxCell id="c2hirin32" value="&lt;b&gt;Not yet&lt;/b&gt; — the minimum score is never shown; add-ons can raise the score." style="shape=note;size=14;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontColor=#5D4037;align=left;spacing=6;" vertex="1" parent="c2hirin7"><mxGeometry x="676" y="198.0" width="164" height="80" as="geometry"/></mxCell><mxCell id="c2hirin33" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#424242'&gt;Answer screening questions (assistant only proposes)&lt;/span&gt;" s