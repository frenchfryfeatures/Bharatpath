# Repository-wide ignores. Language-specific rules live in backend/.gitignore
# and (when it lands) frontend/.gitignore, so each stack owns its own noise.

# secrets — never commit a real .env
.env
.env.*
!.env.example
*.pem
*.key
mobile-app/google-services.json

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
yarn-error.log*

# node (for the frontend arriving in this repo)
node_modules/
.next/
dist/
build/
coverage/

# claude code local session artefacts (hook logs, transcripts)
.claude/

# archives and uv
*.zip
uv.lock
