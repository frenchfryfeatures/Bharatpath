# Where the portal (the `frontend/` app) is served. Every sign-in and sign-up
# link on the website points here.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Public address of this website, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Store listings. Leave the App Store one empty until the iOS app is live;
# the badge then reads "Coming soon" instead of linking nowhere.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.bharatpath.app
NEXT_PUBLIC_APP_STORE_URL=

# Public contact inbox shown on the website.
NEXT_PUBLIC_CONTACT_EMAIL=hello@bharatpath.com
